{
  "info": {
    "_postman_id": "5a740110-b7cb-48a5-a171-f943b829b560",
    "name": "SIPUS-Del API v1",
    "description": "Koleksi uji SOAP, REST provider/consumer, Sanctum, dan integrasi GitHub. Simpan token hanya pada environment lokal Postman; jangan commit token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "app_url", "value": "http://127.0.0.1:8000" },
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "buku_id", "value": "1" },
    { "key": "peminjaman_id", "value": "1" },
    { "key": "kategori_id", "value": "1" },
    { "key": "github_token", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Login petugas') {",
          "  const body = pm.response.json();",
          "  if (body.data && body.data.access_token) pm.collectionVariables.set('token', body.data.access_token);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "SOAP Clearance",
      "item": [
        {
          "name": "GET WSDL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{app_url}}/soap/sipus.wsdl"
          }
        },
        {
          "name": "POST CheckClearanceStatus",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/xml; charset=utf-8" }],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\"?><soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"https://sipus.del.ac.id/soap\"><soap:Body><m:CheckClearanceStatusRequest><m:nim_peminjam>12S24044</m:nim_peminjam></m:CheckClearanceStatusRequest></soap:Body></soap:Envelope>"
            },
            "url": "{{app_url}}/soap/sipus"
          }
        },
        {
          "name": "POST malformed XML - SOAP Fault",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/xml; charset=utf-8" }],
            "body": { "mode": "raw", "raw": "<soap:Envelope" },
            "url": "{{app_url}}/soap/sipus"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login petugas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pustakawan@del.ac.id\",\n  \"password\": \"password123\",\n  \"device_name\": \"postman-client\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "GET current user",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/auth/me" }
        },
        {
          "name": "POST logout (revoke token)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "GET paginated catalog with filters and sorting",
          "request": { "method": "GET", "url": "{{base_url}}/bukus?search=laravel&kategori_id={{kategori_id}}&tersedia=1&sort=judul&dir=asc&per_page=5" }
        },
        {
          "name": "GET book detail and borrowing history",
          "request": { "method": "GET", "url": "{{base_url}}/bukus/{{buku_id}}" }
        },
        {
          "name": "POST create book (201 + Location)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isbn\": \"9786230000001\",\n  \"judul\": \"Pemrograman Web API\",\n  \"penulis\": \"Penulis Del\",\n  \"penerbit\": \"Penerbit Del\",\n  \"tahun_terbit\": 2026,\n  \"kategori_id\": {{kategori_id}},\n  \"stok\": 3,\n  \"sinopsis\": \"Contoh buku untuk pengujian API.\"\n}" },
            "url": "{{base_url}}/bukus"
          }
        },
        {
          "name": "PATCH partial update (stok only)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"stok\": 8 }" },
            "url": "{{base_url}}/bukus/{{buku_id}}"
          }
        },
        {
          "name": "PUT full replacement",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isbn\": \"9786230000001\",\n  \"judul\": \"Pemrograman Web API\",\n  \"penulis\": \"Penulis Del\",\n  \"penerbit\": \"Penerbit Del\",\n  \"tahun_terbit\": 2026,\n  \"kategori_id\": {{kategori_id}},\n  \"stok\": 5,\n  \"sinopsis\": null\n}" },
            "url": "{{base_url}}/bukus/{{buku_id}}"
          }
        },
        {
          "name": "DELETE book (409 if active loans)",
          "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/bukus/{{buku_id}}" }
        },
        {
          "name": "GET Open Library external metadata",
          "request": { "method": "GET", "url": "{{base_url}}/bukus/{{buku_id}}/referensi-eksternal" }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "GET loans filtered by status and NIM",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/peminjamans?status=dipinjam&nim=12S24044&per_page=10" }
        },
        {
          "name": "POST borrow book",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"buku_id\": {{buku_id}},\n  \"nim_peminjam\": \"12S24044\",\n  \"nama_peminjam\": \"Mahasiswa Del\",\n  \"durasi_hari\": 7\n}" },
            "url": "{{base_url}}/peminjamans"
          }
        },
        {
          "name": "PATCH return book (409 if already returned)",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{base_url}}/peminjamans/{{peminjaman_id}}/kembalikan" }
        }
      ]
    },
    {
      "name": "GitHub API consumer exercise",
      "item": [
        {
          "name": "GET public GitHub profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/vnd.github+json" }],
            "url": "https://api.github.com/users/octocat"
          }
        },
        {
          "name": "PATCH authenticated GitHub profile (optional exercise)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{github_token}}", "type": "string" }] },
            "header": [{ "key": "Accept", "value": "application/vnd.github+json" }, { "key": "X-GitHub-Api-Version", "value": "2022-11-28" }],
            "body": { "mode": "raw", "raw": "{\n  \"bio\": \"Mahasiswa PPW - token jangan disimpan di repository\"\n}" },
            "url": "https://api.github.com/user",
            "description": "Isi github_token hanya pada environment lokal Postman. Jangan ekspor/commit token; revoke setelah praktikum."
          }
        }
      ]
    }
  ]
}
